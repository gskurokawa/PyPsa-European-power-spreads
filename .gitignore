# ---- data -----------------------------------------------------------------
# Nothing under data/ is committed. Every input is public and is rebuilt by
# the scripts in scripts/; the raw JAO domain alone is ~120 MB a year.
data/raw/
data/processed/
data/fleet/
*.nc
*.parquet

# ---- run output -----------------------------------------------------------
# logs/ is the per-run output of 10_build_network.py. The *.log rule catches
# redirected console output such as mc_run.log, which run_mc.py can produce at
# several MB a batch.
logs/
*.log

